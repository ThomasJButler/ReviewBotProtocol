# ReviewBot Protocol backend. Copy to .env and fill in the GitHub values.
# There is no inference API key: the model is a local Ollama instance.
# Keep comments on their own lines; a comment after an empty value becomes the value.

# GitHub App (required). Generate the webhook secret with: openssl rand -hex 32
GITHUB_APP_ID=
# Path to the downloaded PEM (keep it outside the repository), or the PEM text, or base64 of it
GITHUB_PRIVATE_KEY=../../github-app.pem
GITHUB_WEBHOOK_SECRET=

# Network. Add the tunnel or reverse-proxy hostname to ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000

# Local model. OLLAMA_MODEL can be qwen3-coder:30b once pulled. Never a cloud-tagged model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2000
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=600

# Review limits. MAX_PATCH_BYTES must fit OLLAMA_NUM_CTX at roughly 2.8 bytes per token.
REVIEW_TIMEOUT_SECONDS=900
REVIEW_DRAFTS=false
MAX_FILES_PER_REVIEW=25
MAX_PATCH_BYTES=32000
MAX_WEBHOOK_BODY_BYTES=2097152
MAX_INLINE_COMMENTS=25
MIN_FINDING_CONFIDENCE=0.5
# Second model pass per finding that tries to disprove it before posting. Slower, fewer false positives.
VERIFY_FINDINGS=false

# Dashboard API token (the API is off until this is set). Generate with: openssl rand -hex 24
LOCAL_API_TOKEN=

# Refuse to start if a cloud API key, a LangSmith tracing variable, a non-loopback
# OLLAMA_BASE_URL or a cloud-tagged model is configured
STRICT_LOCAL=true

LOG_LEVEL=INFO
# true logs redacted prompts and redacted model output
LOG_PROMPTS=false
DATABASE_URL=sqlite:///./reviews.db
DEBUG=false
