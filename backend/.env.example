# ReviewBot Protocol backend. Copy to .env and fill in the three GitHub values.
# There is no inference API key: the model is a local Ollama instance.

# GitHub App (required)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=./github-app.pem      # path to the PEM, or the PEM text, or base64 of it
GITHUB_WEBHOOK_SECRET=                   # generate with: openssl rand -hex 32

# Network
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1        # add the tunnel or reverse-proxy hostname
ALLOWED_ORIGINS=http://localhost:3000

# Local model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b                  # or qwen3-coder:30b once pulled
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2000
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=600

# Review limits
REVIEW_TIMEOUT_SECONDS=900
REVIEW_DRAFTS=false
MAX_FILES_PER_REVIEW=25
MAX_PATCH_BYTES=40000
MAX_WEBHOOK_BODY_BYTES=2097152
MAX_INLINE_COMMENTS=25
MIN_FINDING_CONFIDENCE=0.5

# Dashboard API (off until set). Generate with: openssl rand -hex 24
LOCAL_API_TOKEN=

# Refuse to start if a cloud API key or LangSmith tracing is in the environment
STRICT_LOCAL=true

LOG_LEVEL=INFO
LOG_PROMPTS=false                        # true logs redacted prompts and raw model output
DATABASE_URL=sqlite:///./reviews.db
DEBUG=false
