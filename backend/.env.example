# Git Review Assistant Backend Configuration

# Application Settings
APP_NAME="Git Review Assistant API"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="your-secret-key-here-generate-a-secure-one"
HOST="0.0.0.0"
PORT=8000

# CORS Settings (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,https://localhost:3000,https://your-domain.com"

# GitHub App Configuration
GITHUB_APP_ID="your-github-app-id"
GITHUB_PRIVATE_KEY="your-github-private-key-content-or-path"
GITHUB_WEBHOOK_SECRET="your-webhook-secret"
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# OpenAI Configuration
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000

# LangChain Configuration (Course Requirements)
LANGCHAIN_API_KEY="ls__your-langsmith-api-key"
LANGCHAIN_PROJECT="git-review-assistant"
LANGCHAIN_TRACING_V2=true

# Database Configuration
DATABASE_URL="sqlite:///./reviews.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost/git_review_assistant"
DATABASE_ECHO=false

# Redis Configuration (for background processing)
REDIS_URL="redis://localhost:6379"
REDIS_DB=0
REDIS_PASSWORD=""

# Rate Limiting
GITHUB_API_RATE_LIMIT=5000
REVIEW_RATE_LIMIT=100

# Security Settings
WEBHOOK_TIMEOUT=30
MAX_FILE_SIZE=10485760  # 10MB
MAX_FILES_PER_PR=100

# Monitoring & Logging
LOG_LEVEL="INFO"
SENTRY_DSN=""  # Optional Sentry error tracking
STRUCTURED_LOGGING=true

# Review Engine Settings
SECURITY_SCAN_ENABLED=true
PERFORMANCE_ANALYSIS_ENABLED=true
QUALITY_ANALYSIS_ENABLED=true
MAX_REVIEW_TIME=300  # 5 minutes

# Optional - Additional AI Providers
ANTHROPIC_API_KEY=""  # For Claude integration

# Production Settings (Railway/Render)
# PORT is automatically set by the platform
# DATABASE_URL will be provided by the database addon