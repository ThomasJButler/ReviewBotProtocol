# ReviewBot Protocol backend. Copy to .env and fill in the GitHub values.
# There is no inference API key: the model is a local Ollama instance.
# Keep comments on their own lines; a comment after an empty value becomes the value.

# GitHub App (required). Generate the webhook secret with: openssl rand -hex 32
GITHUB_APP_ID=
# Path to the downloaded PEM (keep it outside the repository), or the PEM text, or base64 of it
GITHUB_PRIVATE_KEY=~/.config/reviewbot/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Network. Add the tunnel or reverse-proxy hostname to ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000

# Local model. OLLAMA_MODEL can be qwen3-coder:30b once pulled. Never a cloud-tagged model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2000
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=600

# Review limits. MAX_PATCH_BYTES must fit OLLAMA_NUM_CTX at roughly 2.8 bytes per token.
REVIEW_TIMEOUT_SECONDS=3600
# A review's own budget is files times this, never above the ceiling; a two-file pull request gets ten minutes, not an hour. 0 leaves only the ceiling.
REVIEW_SECONDS_PER_FILE=300
REVIEW_DRAFTS=false
# Pull requests opened by a bot (dependabot, renovate) are skipped unless this is true; each review costs the machine about an hour.
REVIEW_BOT_PULL_REQUESTS=false
MAX_FILES_PER_REVIEW=25
MAX_PATCH_BYTES=32000
MAX_WEBHOOK_BODY_BYTES=2097152
MAX_INLINE_COMMENTS=25
MIN_FINDING_CONFIDENCE=0.5
# Second model pass per finding that tries to disprove it before posting. Slower, fewer false positives.
VERIFY_FINDINGS=false
MAX_VERIFY_CALLS_PER_REVIEW=40
# A second model from a different family that cross-examines each file's review: it refutes
# false positives and adds what the first model missed. Also on loopback. Empty means off.
CROSS_EXAMINE_MODEL=
CROSS_EXAMINE_MAX_CALLS_PER_REVIEW=25
# Optional, for a machine that cannot hold both models at once (a 9B plus a 12B need about 15 GB
# resident): review every file with the first model, unload it, cross-examine every file with the
# second, unload that. Same result, a slower review; a review of 25 rewrite-sized files takes about an hour with it, so the ceiling is an hour.
CROSS_EXAMINE_SEQUENTIAL=false
# The cross-examiner writes its note before its verdicts (measured; see docs/benchmarks).
CROSS_EXAMINE_NOTE_FIRST=false

# Dashboard API token (the API is off until this is set). Generate with: openssl rand -hex 24
LOCAL_API_TOKEN=

# Refuse to start if a cloud API key, a LangSmith tracing variable, a non-loopback
# OLLAMA_BASE_URL or a cloud-tagged model is configured
STRICT_LOCAL=true

LOG_LEVEL=INFO
# true logs redacted prompts and redacted model output
LOG_PROMPTS=false
DATABASE_URL=sqlite:///./reviews.db
DEBUG=false
